{
  "manifest_version": 3,
  "name": "Bookmark Suggestions — My Bookmarks Dashboard",
  "version": "1.0.0",
  "description": "Suggests pages you visit as bookmarks in your local Bookmark Dashboard. All data stays in your browser — no servers, no accounts.",
  "permissions": ["tabs", "storage"],
  "host_permissions": [],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Bookmark Suggestions",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["file:///*/my-bookmarks-app/*", "file:///*/Bookmarks/*", "file:///*/bookmarks/*"],
      "js": ["shared/suggest-core.js", "bridge.js"],
      "run_at": "document_idle"
    }
  ],
  "minimum_chrome_version": "102"
}
